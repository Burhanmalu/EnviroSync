# Application
PROJECT_NAME="Smart Indoor Environment Monitoring & Automated Comfort Control System"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database (Default SQLite for instant setup, or Postgres postgresql+asyncpg://user:pass@localhost:5432/envirosync)
DATABASE_URL="sqlite+aiosqlite:///./smart_indoor.db"
SYNC_DATABASE_URL="sqlite:///./smart_indoor.db"
DB_ECHO=False

# JWT Security
SECRET_KEY="envirosync-super-secret-jwt-signing-key-production-grade-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MQTT Settings
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPIC_PREFIX="smart-building"
MQTT_ENABLED=False

# Continuous Simulation
SIMULATION_ENABLED=True
SIMULATION_INTERVAL_SECONDS=3.0

# Camera
CAMERA_SOURCE="mock"
CAMERA_RTSP_URL=""
CAMERA_FPS=5

# Demo Mode
DEMO_DEFAULT_SCENARIO="NORMAL"
